                }
              }
            }
          }
        }
      }
    },
    "会从 %lld 台机器上一起移除。": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It will also be removed from %lld host."
                }
