{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 未登录，PR 功能不可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t signed in; PR features are unavailable"
          }
        }
      }
    },
    "GitHub 命令行未登录（在主机上运行 gh auth login）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI isn’t signed in (run gh auth login on the host)"
          }
        }
      }
    },
    "GitLab 命令行未登录（在主机上运行 glab auth login）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab CLI isn’t signed in (run glab auth login on the host)"
          }
        }
      }
    },
    "daemon 太旧或握手被拒：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "daemon is too old or the handshake was rejected: %@"
          }
        }
      }
    },
